{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "browser:install": "playwright install chromium --only-shell",
        "browser:install-deps": "playwright install-deps chromium",
        "test:browser:check": "node tests/Browser/check-environment.cjs",
        "test:browser:learning": "node tests/Browser/learning-flow.cjs",
        "test:browser:tools": "node tests/Browser/tool-flow.cjs",
        "test:browser": "npm run test:browser:learning && npm run test:browser:tools && npm run test:browser:calendar && npm run test:browser:password-browser && npm run test:browser:text-tools && npm run test:browser:date-tools && npm run test:browser:unit-converter && npm run test:browser:time-tools && npm run test:browser:calculation-tools && npm run test:browser:tabular-data-converter && npm run test:browser:excel-to-csv && npm run test:browser:json-tools",
        "test:browser:calendar": "node tests/Browser/calendar-flow.cjs",
        "test:js": "node --test tests/Unit/*.test.mjs",
        "test:browser:password-browser": "node tests/Browser/browser-password-flow.cjs",
        "test:browser:text-tools": "node tests/Browser/text-tools-flow.cjs",
        "test:browser:tabular-data-converter": "node tests/Browser/tabular-data-converter-flow.mjs",
        "test:browser:excel-to-csv": "node tests/Browser/excel-to-csv-flow.mjs",
        "test:browser:date-tools": "node tests/Browser/date-tools-flow.cjs",
        "test:browser:unit-converter": "node tests/Browser/unit-converter-flow.cjs",
        "test:browser:time-tools": "node tests/Browser/time-tools-flow.cjs",
        "test:browser:calculation-tools": "node tests/Browser/calculation-tools-flow.cjs",
        "test:browser:json-tools": "node tests/Browser/json-tools-flow.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "playwright": "1.64.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "ajv": "8.20.0",
        "encoding-japanese": "2.4.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    }
}
